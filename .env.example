# ---- OpenRouter (primary) ----
OPENROUTER_API_KEY=your-openrouter-api-key
# 2-3 specific free models tried in order, THEN the generic router below.
# Free model IDs change often - verify at https://openrouter.ai/models?q=free
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-coder:free,google/gemma-3-27b-it:free
OPENROUTER_FALLBACK_MODEL=openrouter/free

# ---- Groq (second fallback) ----
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile

# ---- Ollama (last fallback, local) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELS=llama3.1

# ---- Limits ----
MAX_INPUT_CHARS=60000
MAX_REVISIONS=2
